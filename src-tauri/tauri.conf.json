{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-nest",
  "version": "0.1.0",
  "identifier": "dev.git-nest.desktop",
  "build": {
    "frontendDist": "../apps/web/dist",
    "beforeBuildCommand": "pnpm -C apps/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/git-nest-server"
    ],
    "resources": [
      "binaries/node-resources/git-nest-server/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
